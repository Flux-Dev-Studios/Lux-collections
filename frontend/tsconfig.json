{
  "compilerOptions": {
    "target": "ES2022",
    "allowJs": true,
    "checkJs": false,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist/assets",
    "tsBuildInfoFile": ".tsbuildinfo",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
