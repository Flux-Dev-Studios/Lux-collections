{
  "name": "lux-collection-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express and PostgreSQL API for Lux Collection.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --build && tsc --build ../frontend && node dist/scripts/copy-frontend.js",
    "start": "npm run build && node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "dev:all": "npm run dev:watch",
    "seed": "node dist/seed.js",
    "migrate": "node dist/scripts/migrate.js",
    "db:watch": "npm run build && node dist/scripts/watch-database.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
