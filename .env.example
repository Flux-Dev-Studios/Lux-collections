NODE_ENV=development
PORT=3000
# Copy the Session Pooler URI from Supabase Dashboard → Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DATABASE_SSL=true
# Optional: path to the Supabase database CA certificate downloaded from Dashboard > Database > SSL Configuration.
# DATABASE_SSL_CA=backend/certs/prod-ca-2021.crt
APP_ORIGIN=http://localhost:3000
SESSION_DAYS=7
# Resend is used to deliver password reset links. Verify this sender in Resend first.
RESEND_API_KEY=
MAIL_FROM=Lux Collection <accounts@example.com>
# Stripe Checkout uses GBP. Configure a test key and webhook secret for local testing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
